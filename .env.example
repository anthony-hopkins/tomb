# Battle.net OAuth2 application credentials (https://develop.battle.net)
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
BNET_REDIRECT_URL=http://localhost:8080/auth/callback

# The single Blizzard region this deployment serves (FR-014).
BNET_REGION=us

# TOMB guild identity used for membership verification (FR-013).
# TOMB_GUILD_REALM is a realm *slug* (lowercase, hyphenated), e.g. "area-52".
TOMB_GUILD_NAME=TOMB
TOMB_GUILD_REALM=

# Postgres connection string. The compose stack provides this value for you.
DATABASE_URL=postgres://tomb:tomb@db:5432/tomb?sslmode=disable

# MUST be true everywhere except local plain-HTTP development.
SESSION_COOKIE_SECURE=false

# Optional: override the Blizzard API host (used by quickstart failure testing).
# BNET_API_HOST=https://us.api.blizzard.com
