# Copy to terraform.tfvars (gitignored) and fill in.
project_id        = "your-gcp-project-id"
region            = "us-central1"
github_repository = "anthony-hopkins/tomb"

# Bucket names are globally unique across Google Cloud. If this one is taken,
# add a suffix here AND in the backend block of ../versions.tf.
state_bucket = "tomb-platform-tfstate"
