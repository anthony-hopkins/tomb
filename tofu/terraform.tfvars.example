# Copy to terraform.tfvars (gitignored) and fill in.
project_id     = "your-gcp-project-id"
region         = "us-central1"
zone           = "us-central1-a"
guild_realm    = "your-realm-slug"
bnet_client_id = "your-battlenet-client-id"
image          = "us-central1-docker.pkg.dev/your-gcp-project-id/tomb/platform:latest"

# Hostname for TLS. Leave empty and the stack serves on <dashed-ip>.sslip.io,
# which is real DNS pointing at the VM, so Let's Encrypt still issues a
# certificate. Set a real domain when you have one.
domain     = ""
acme_email = ""

# --- Sizing (see tofu/README.md for costs) -------------------------------
# e2-small (0.5 vCPU, 2 GiB) ~$12.23/month is the default and fits one guild.
# machine_type   = "e2-micro"   # 1 GiB, ~$6.11/mo, free-tier eligible, tight
# machine_type   = "e2-medium"  # 4 GiB, ~$24.48/mo
# boot_disk_size = 20
# data_disk_size = 10
# disk_type      = "pd-standard"

# CIDRs allowed to reach port 22 directly. Empty means SSH via IAP only.
# ssh_source_ranges = ["203.0.113.4/32"]
