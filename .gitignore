# Claude Code machine-local settings — may contain per-machine config.
# .claude/skills/ IS tracked: those are the Spec Kit workflow, meant to be shared.
.claude/settings.local.json
.claude/*.local.json

# Editor and OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Go build output
*.exe
*.exe~
*.test
*.out
/tomb
/bin/
vendor/

# Local environment — never commit real credentials
.env
.env.local

# OpenTofu / Terraform state, plans and local plugin cache
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log

# Saved plan files. These are build artifacts, and they embed resource
# attribute values in cleartext -- a plan of tofu/ contains the generated
# Postgres password, verified by inspecting one. Never commit them.
tfplan
tfplan.*
*.tfplan
*.tfplan.json
