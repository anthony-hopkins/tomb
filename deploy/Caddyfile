# Caddy obtains and renews a Let's Encrypt certificate for TOMB_DOMAIN
# automatically, and redirects HTTP to HTTPS. HTTPS is mandatory here: Blizzard
# rejects a plain-HTTP OAuth redirect URI, and the app issues Secure cookies.

{
	# An `email` directive with no argument is a Caddyfile PARSE ERROR, not an
	# ignored empty value -- Caddy refuses to start and the site never binds
	# 443. So when ACME_EMAIL is unset, startup.sh and deploy.sh delete the
	# line below before Caddy ever sees it, leaving an empty options block,
	# which is valid. Caddy then registers with Let's Encrypt anonymously.
	# Verified with `caddy validate` against caddy:2-alpine.
	email {$ACME_EMAIL}
}

{$TOMB_DOMAIN} {
	encode zstd gzip

	reverse_proxy app:8080 {
		# The app builds absolute URLs and decides cookie flags from these.
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}

		# A dashboard view fans out to Blizzard (1 + N calls), so allow more
		# than Caddy's default patience before giving up on the upstream.
		transport http {
			response_header_timeout 60s
		}
	}

	log {
		output stdout
		format console
	}
}
